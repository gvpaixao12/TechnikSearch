# ===== Core =====
GROQ_API_KEY=cole_aqui_a_chave_do_console_groq
PORT=3001

# ===== Imagens dos carros =====
# Chave Groq separada para o validador vision (opcional).
# Se vazia, cai no GROQ_API_KEY. Recomendado ter separada para
# poder revogar a feature de imagens isoladamente.
GROQ_VISION_API_KEY=

# Serper.dev — busca de imagens (fallback quando Wikimedia Commons não tem).
# Free tier: 2.500 buscas one-time no signup, sem cartão.
# https://serper.dev/api-key
SERPER_API_KEY=

# Supabase — BANCO apenas: índice das fotos (car_images_cache), histórico e
# rascunhos. Os arquivos de foto NÃO ficam mais aqui (ver R2 abaixo).
# Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role key — SOMENTE backend, bypassa RLS, nunca expor no frontend
SUPABASE_SERVICE_KEY=

# ===== Cloudflare R2 — arquivos das fotos =====
# Free tier: 10 GB de storage e egress ZERO (servir foto não custa nada).
# Cloudflare Dashboard → R2 → Manage API Tokens → Create API Token
#   permissão: "Object Read & Write", escopo: só o bucket car-images.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=car-images
# Base pública do bucket, SEM barra no fim. Duas opções:
#   1) R2 → bucket → Settings → Public Development URL  → https://pub-xxxx.r2.dev
#   2) domínio custom (recomendado em produção)         → https://fotos.seudominio.com
R2_PUBLIC_BASE=https://pub-xxxxxxxxxxxx.r2.dev
